{
  "name": "dramapilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DramaPilot three-layer localization, offline engineering preview",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/src/**/*.test.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "smoke:dsh": "npm run build && node scripts/dsh-smoke.mjs",
    "fixture:media": "npm run build && node dist/fixtures/media/generate.js",
    "prepack": "npm run build"
  },
  "exports": {
    ".": "./dist/src/dsh/index.js",
    "./contracts": "./dist/src/contracts/index.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "fixtures/adaptation",
    "docs/public",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanweiping1012-source/DramaPilot.git"
  },
  "homepage": "https://github.com/tanweiping1012-source/DramaPilot#readme",
  "bugs": {
    "url": "https://github.com/tanweiping1012-source/DramaPilot/issues"
  }
}
